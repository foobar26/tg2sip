TG_API_ID=
TG_API_HASH=
TG_FORWARD_USER_ID=

SIP_USERNAME=tg2sip
SIP_PASSWORD=changeme
SIP_DOMAIN=127.0.0.1
SIP_REGISTRAR=127.0.0.1:5060

# Optional: make calls *video* calls, showing this stream as the camera.
# Any ffmpeg-readable input (MJPEG/HTTP/RTSP/file). Leave blank for audio-only.
VIDEO_SOURCE_URL=
# Optional HTTP/RTSP basic-auth credentials for VIDEO_SOURCE_URL.
VIDEO_SOURCE_USER=
VIDEO_SOURCE_PASS=
# Extra ffmpeg input options (before -i). For MJPEG cameras whose multipart
# stream trips ffmpeg's mpjpeg demuxer (e.g. Doorbird), force: -f mjpeg
VIDEO_INPUT_ARGS=
# Full source-command override (advanced). If set, used instead of
# VIDEO_SOURCE_URL. This is a plain /bin/sh script (NOT wrapped in sh -c, no
# surrounding quotes); it's written to a file and run with sh, so pipes, loops
# and quotes work normally. It must write raw yuv420p frames (matching the
# video: WxH/fps in config.yaml) to stdout. Example: poll a Doorbird snapshot
# endpoint (sidesteps the MJPEG multipart bug and missing RTSP):
#   VIDEO_SOURCE_CMD=while :; do curl -s -u USER:PASS http://CAM/bha-api/image.cgi; done | ffmpeg -v error -f image2pipe -framerate 10 -i pipe:0 -f rawvideo -pix_fmt yuv420p -vf scale=640:480 -r 10 pipe:1
VIDEO_SOURCE_CMD=
# Set to 0 to drop the H264 video encoder (workaround for an illegal-instruction
# crash in the prebuilt video codecs on older CPUs without AVX2).
VIDEO_H264=1

LOG_LEVEL=INFO
