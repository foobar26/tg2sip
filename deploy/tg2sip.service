[Unit]
Description=tg2sip — SIP <-> Telegram gateway (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/frank/tg2sip
# Uses the already-built image; does NOT rebuild (build manually when needed).
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose up -d
# First start may pull/create; don't time out.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
